  color: var(--ember-bright);
  border-color: var(--ember-bright);
}

/* ---------------------------------------------
   Footer
--------------------------------------------- */
.site-footer {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 28px var(--edge) 40px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--bone-dim);
}

/* ---------------------------------------------
   Responsive
--------------------------------------------- */
@media (max-width: 640px) {
  .stream-grid {
    grid-template-columns: 1fr;
  }

  .log-entry {
    grid-template-columns: 60px 1fr;
    gap: 14px;
  }

  .site-nav {
    gap: 14px;
  }

  .site-nav a {
    font-size: 0.66rem;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .about-photo {
    max-width: 200px;
    margin: 0 auto;
  }

  .gallery-craft {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-moments {
    grid-template-columns: 1fr;
  }
}

